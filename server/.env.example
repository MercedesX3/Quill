# Supabase project URL (Project Settings → API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase key: use the service_role key for this backend so inserts/updates
# work regardless of RLS, OR use anon + Row Level Security policies you define.
SUPABASE_KEY=your_service_role_or_anon_key_here
